# Copy to .env.local for development. Real values live in Coolify's environment settings.

# Orion's own Postgres database (Coolify database service). Holds only Orion's data (D3).
DATABASE_URL=postgres://orion:change-me@localhost:5432/orion

# Key used to encrypt the connection key and Application Passwords at rest.
# 32 random bytes, base64. Generate with: openssl rand -base64 32
ORION_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# Optional. Orion's public https:// address, used for the WordPress account-linking return
# URL. Normally worked out from the request; set it if that comes out wrong.
# ORION_PUBLIC_URL=https://orion.example.com
