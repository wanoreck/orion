{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "Bash(git push origin main)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(docker *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --prune*)",
      "Bash(git push * --prune*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(git clean -x*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout -f*)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(git branch -f *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(git gc --prune*)",
      "Bash(git update-ref -d *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git tag -d *)",
      "Bash(git remote set-url *)",
      "Bash(git remote add *)",
      "Bash(git remote remove *)",
      "Bash(git config *)"
    ],
    "ask": [
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": ["/home", "/root", "/srv", "/opt", "/mnt", "/media", "/var"],
      "allowRead": ["~"],
      "denyWrite": ["./.claude/settings.json", "./.claude/hooks"]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "codeload.github.com",
        "objects.githubusercontent.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-writes.mjs\"",
            "statusMessage": "Checking write path"
          }
        ]
      }
    ]
  }
}
